import os
Import('RTT_ROOT')
Import('env')
from building import *

cwd = GetCurrentDir()
root = os.path.abspath(os.path.join(cwd, '..'))
env.Append(CPPDEFINES=[rtconfig.MCU, 'COOLING_BOOTLOADER_BUILD'])

# Bootloader 自身源码由当前 SConscript 的 VariantDir 统一放入 build。
local_src = [
    'main.c',
    'boot_fota.c',
    'uid_key_slot.c',
]

# 复用 App/公共层源码时不能把绝对 .c 路径直接交给 DefineGroup，
# 否则 SCons 会把 .o 写回源码旁。这里保留相对目录结构，并把所有
# 中间目标显式放到 bootloader/build/external 下。
external_src = [
    os.path.join('board', 'board.c'),
    os.path.join('board', 'CubeMX_Config', 'Src', 'stm32f3xx_hal_msp.c'),
    os.path.join('common', 'fal_flash_f302.c'),
    os.path.join('common', 'fota_crc.c'),
    os.path.join('common', 'fota_rbl.c'),
    os.path.join('common', 'fota_meta.c'),
    os.path.join('common', 'fota_storage.c'),
    os.path.join('common', 'fota_can.c'),
    os.path.join('common', 'can', 'can_bus.c'),
    os.path.join('applications', 'uid', 'cooling_uid_auth.c'),
    os.path.join('applications', 'uid', 'UID_Encryption.c'),
]

path = [
    cwd,
    os.path.join(root, 'board'),
    os.path.join(root, 'board', 'CubeMX_Config', 'Inc'),
    os.path.join(root, 'common'),
    os.path.join(root, 'common', 'can'),
    os.path.join(root, 'applications'),
    os.path.join(root, 'applications', 'uid'),
]

group = DefineGroup('CoolingBootloader', local_src, depend=[''], CPPPATH=path)

for relative_source in external_src:
    source = os.path.join(root, relative_source)
    target_without_suffix = os.path.splitext(relative_source)[0]
    target = os.path.join(cwd, 'build', 'external', target_without_suffix)
    group = group + env.Object(target=target, source=source)

# 各软件包显式映射到 Bootloader 自己的 build 目录，不能复用 App 的 .o。
for package_name in [
    'CMSIS-Core-latest',
    'stm32f3_cmsis_driver-latest',
    'stm32f3_hal_driver-latest',
]:
    group = group + SConscript(
        os.path.join(root, 'packages', package_name, 'SConscript'),
        variant_dir=os.path.join('build', 'packages', package_name),
        duplicate=0)

Return('group')
